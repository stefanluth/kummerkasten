{
  "name": "kummerkasten",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=24.15.0",
    "npm": ">=11"
  },
  "scripts": {
    "build": "next build",
    "lint": "eslint .",
    "dev": "next dev",
    "start": "next start",
    "prepare:db": "prisma migrate deploy && prisma generate",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:unit",
    "db:deploy": "prisma migrate deploy",
    "db:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "isomorphic-dompurify": "^4.7.0",
    "marked": "^18.2.0",
    "next": "^16.4.6",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.16.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "^18.0.10",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.6",
    "postcss": "^8.5.32",
    "prettier": "^3.10.1",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "brace-expansion@^1.1.7": "1.1.22",
    "brace-expansion@^2.0.2": "2.1.8",
    "brace-expansion@^5.0.8": "5.0.13",
    "undici": "8.12.4"
  }
}
