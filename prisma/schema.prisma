generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Post {
  id        String   @id @unique @default(uuid())
  title     String
  content   String
  replyTo   String?
  createdAt DateTime @default(now())
  parent    Post?    @relation("PostReplies", fields: [replyTo], references: [id], onDelete: Cascade, onUpdate: Cascade)
  replies   Post[]   @relation("PostReplies")
  reports   Report[]
  votes     Vote[]

  @@index([replyTo, createdAt(sort: Desc), id])
}

model Vote {
  id          String  @id @unique @default(uuid())
  fingerprint String
  postId      String
  upvote      Boolean
  Post        Post    @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, fingerprint])
  @@index([postId, upvote])
}

model Report {
  id          String @id @unique @default(uuid())
  fingerprint String
  post        Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId      String

  @@unique([postId, fingerprint])
}
